{
    "name": "ose-backend",
    "version": "1.0.0",
    "private": true,
    "description": "OS&E Inventory System — Backend API",
    "main": "src/server.js",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "nodemon src/server.js",
        "start": "node src/server.js",
        "start:prod": "prisma migrate deploy && node seed-super-admin.js && node prisma/seed-units.js && node src/server.js",
        "postinstall": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "prisma migrate deploy",
        "db:baseline": "node scripts/baseline-migrations.js",
        "db:seed": "node prisma/seeds/index.js",
        "db:studio": "prisma studio",
        "db:generate": "prisma generate",
        "db:reset": "prisma migrate reset --force",
        "db:up": "node scripts/db-up.js",
        "db:down": "node scripts/db-down.js",
        "db:push": "prisma db push",
        "verify:general-manager": "node scripts/verify-general-manager-rbac.js",
        "rbac:sync-org-manager": "node scripts/grant-org-manager-permissions.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1036.0",
        "@aws-sdk/s3-request-presigner": "^3.1036.0",
        "@prisma/client": "^5.10.2",
        "adm-zip": "^0.5.16",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "exceljs": "^4.4.0",
        "express": "^4.18.3",
        "express-async-errors": "^3.1.1",
        "express-rate-limit": "^7.2.0",
        "express-validator": "^7.0.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^4.2.1",
        "nodemailer": "^8.0.1",
        "pdf-parse": "^2.4.5",
        "pdfkit": "^0.17.2",
        "prisma": "^5.10.2",
        "resend": "^6.12.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^9.0.1",
        "winston": "^3.12.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "nodemon": "^3.1.0"
    }
}
