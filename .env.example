# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Proxy hops (Railway/Heroku/Vercel: 1). Must be >=1 for express-rate-limit
# to trust X-Forwarded-For. Raise only if traffic traverses multiple proxies.
TRUST_PROXY_HOPS=1

# ─── Database ────────────────────────────────────────────────────────────────
# Postgres 16. Pick ONE of the three options below and delete the rest.
#
# a) Neon (cloud, free tier, no install). Create a project at neon.tech,
#    the dashboard hands you this string verbatim.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/ose_inventory?sslmode=require
#
# b) Postgres native install (postgres.app on macOS, postgresql.org installer
#    on Windows). No password by default on macOS; Windows prompts during setup.
# DATABASE_URL=postgresql://YOUR_OS_USER@localhost:5432/ose_inventory
#
# c) The repo's docker-compose.yml (Postgres 16 container on host port 5433).
# DATABASE_URL=postgresql://ose_user:ose_password@localhost:5433/ose_inventory

# ─── Auth (JWT) ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ─── Mail (SMTP) ─────────────────────────────────────────────────────────────
# Used by password-reset OTPs + approval/stock-alert notifications. When
# EMAIL_NOTIFICATIONS_ENABLED is not set (or !=false) and SMTP creds are
# present, sends go through immediately; on failure the EmailLog row stays
# PENDING and the scheduler.js cron retries every 2 min with backoff.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="OS&E Inventory <noreply@ose-inventory.local>"

# Set to `false` to suppress all outgoing mail (useful in CI/dev).
# EMAIL_NOTIFICATIONS_ENABLED=true

# Max retries (incl. the first attempt) before an EmailLog is marked DEAD.
EMAIL_MAX_ATTEMPTS=5
# Base delay for exponential backoff (doubles each attempt, capped at 16×).
EMAIL_RETRY_INITIAL_DELAY_SECONDS=60

# ─── File storage ────────────────────────────────────────────────────────────
# `local`: multer keeps bytes on the host filesystem under ./uploads, served
#          via `app.use('/uploads', express.static(...))`. Fine for dev.
# `r2`:    bytes go to Cloudflare R2 (S3-compatible). Use for any shared env
#          (Railway's FS is ephemeral — local files vanish on redeploy).
STORAGE_DRIVER=local

# R2 credentials (only required when STORAGE_DRIVER=r2). Dashboard path:
# Cloudflare → R2 → Manage R2 API Tokens → Create API Token (Object Read+Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ose-inventory
# Auto-derived from R2_ACCOUNT_ID when omitted. Override only if using a
# different S3-compatible provider (AWS S3, MinIO, Backblaze B2, …).
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# TTL for GET /api/files/signed-url?key=... URLs (seconds).
SIGNED_URL_TTL_SECONDS=900

# ─── Misc ────────────────────────────────────────────────────────────────────
# Enable query-level logging from Prisma (noisy — only for debugging).
# LOG_QUERIES=true
